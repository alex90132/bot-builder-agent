TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3.7-plus
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.2

# Адрес конструктора, если в чат прислали только токен mcp_… без блока mcpServers.
# Пусто: https://telegram-bot-builder-e3u-production.up.railway.app
BOT_BUILDER_URL=https://telegram-bot-builder-e3u-production.up.railway.app

# Пусто — бот открыт всем, у кого есть свой mcp-токен
TELEGRAM_ALLOWED_IDS=

AGENT_MAX_ROUNDS=16
AGENT_MAX_RESULT_CHARS=12000
AGENT_HISTORY_MESSAGES=40
MCP_TOOLS_CACHE_SECONDS=300

# Поиск как в chantg404: свой SearXNG. Пусто тоже значит http://localhost:8890
SEARXNG_URL=http://localhost:8890
# Необязательный прокси для открытия страниц: http:// или socks5://
WEB_PROXY=

DATABASE_URL=sqlite://data/agent.db
LOG_LEVEL=INFO
LOG_FILE=logs/bot-builder-agent.log

# Публичный адрес для OAuth. Redirect URI: этот адрес и путь /oauth/callback
OAUTH_PUBLIC_URL=
# Где бот принимает callback. Прокси должен слать /oauth/callback сюда.
OAUTH_LISTEN=127.0.0.1:8787
# true разрешает MCP на localhost и в частной сети. false запрещает.
MCP_ALLOW_PRIVATE=true
